      "severity": "hard",
      "accommodation": { "exerciseId": "lowring_transition", "doseNote": "Keep working the low-ring transition with your feet assisting until the rings-turned-out support hold is there." },
      "rationale": "An unassisted transition finishes in a rings-turned-out support. Without that hold there is nothing to catch, so the attempt collapses at the bottom rather than teaching the movement."
    },
    {
      "id": "dep_rmu_needs_false_grip",
      "subject": { "kind": "goalTerminal", "goalId": "ring_muscle_up" },
      "requires": { "kind": "progression", "progressionId": "rmu_false_grip" },
      "sideRule": "any",
      "constrains": ["prescription"],
      "severity": "soft",
      "rationale": "A false grip is what lets the wrist stay above the ring through the turnover. Without it the muscle-up is still attemptable, but the grip will be the thing that fails first."
    },
    {
      "id": "dep_pistol_needs_ankle",
      "subject": { "kind": "goalTerminal", "goalId": "pistol_squat" },
      "requires": { "kind": "stage", "progressionId": "pistol_ankle_mobility", "stageId": "pistol_ankle_s1" },
