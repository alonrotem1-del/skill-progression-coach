      "constrains": ["prescription", "unlocking", "evidence_validity"],
      "severity": "hard",
      "accommodation": { "exerciseId": "pistol_heel", "doseNote": "Elevate the heel while dorsiflexion is short; it removes the ankle limit without changing the rest of the movement." },
      "rationale": "A full-depth pistol needs the shin to travel forward over the foot. If the ankle cannot reach that range, the depth has to come from somewhere else - usually the lower back - and the rep stops being the movement it looks like."
    },
